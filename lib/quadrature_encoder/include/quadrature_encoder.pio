.program quadrature_encoder
; IN base = gpio_b (bit 0),  JMP PIN = gpio_a
; Y = previous AB state (bits 1:0, layout: bit1=A, bit0=B)
; Pushes new AB on every change

.wrap_target
init:
    ; --- sample both pins into ISR ---
    mov  isr, null
    in   pins, 1          ; ISR[0] = B

    jmp  pin, a_is_1
    in   null, 1          ; ISR[1] = 0 (A=0)
    jmp  do_compare
a_is_1:
    set  x, 1
    in   x,    1          ; ISR[1] = 1 (A=1)

do_compare:
    ; new_ab is in ISR bits [1:0]
    ; we already used it, so this is fine
    mov  x, isr
    jmp  x!=y, changed
    jmp init

changed:
    push noblock
    mov  y, x
.wrap